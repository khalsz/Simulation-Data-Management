[flask]
flask_env = production
debug = False
testing = False
secret_key = {{ secret_token }}

[server]
upload_folder = {{ data_mount }}
ssl_enabled = False
admin_password = {{ admin_password }}
token_lifetime = 3
imas_remote_host = uda.ukaea.uk

[database]
type = postgres
host = localhost
port = 5432
user = simdb
password = {{ db_password }}

[validation]
auto_validate = True
error_on_fail = True

[validation "schema="]
# Validation to use when no schema is specified
path = /home/sim/.config/simdb/validation-schema-plasma.yaml
error_on_fail = True

[validation "schema=plasma"]
path = /home/sim/.config/simdb/validation-schema-plasma.yaml
error_on_fail = True

[validation "schema=step"]
path = /home/sim/.config/simdb/validation-schema-step.yaml
error_on_fail = True

[role "admin"]
users = admin

[cache]
type = FileSystemCache
dir = /home/sim/simdb/cache
default_timeout = 6000
threshold = 100

[authentication]
type = ActiveDirectory
ad_server = MSRV-CCFEPCDCE.CCFEPC.CCFE.AC.UK
ad_domain = ccfepc.ccfe.ac.uk

[development]
disable_checksum = True
