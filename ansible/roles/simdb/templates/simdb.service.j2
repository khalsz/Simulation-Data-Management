[Unit]
Description=simdb gunicorn daemon
After=network.target

[Service]
Type=simple
User=sim
Group=sim
WorkingDirectory={{ install_home }}/current
ExecStart={{ install_home }}/current/bin/gunicorn simdb.remote.wsgi:app \
        --bind=127.0.0.1:8080 \
        --user=sim \
        --log-file={{ install_home }}/logs/simdb.log \
        --workers=4 \
        --timeout=600
ExecReload=/bin/kill -s HUP $MAINPID
KillMode=mixed
TimeoutStopSec=5
PrivateTmp=true
Environment=SIMDB_CONFIG_FILE={{ install_home }}/current/app.cfg

[Install]
WantedBy=multi-user.target
