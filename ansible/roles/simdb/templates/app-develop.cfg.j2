[flask]
flask_env = debug
debug = True
testing = False
secret_key = {{ secret_token }}

[server]
upload_folder = {{ data_home }}
ssl_enabled = False
admin_password = {{ admin_password }}
token_lifetime = 3
imas_remote_host = uda.ukaea.uk
port = 8080

[database]
# type = sqlite
# file = /home/sim/simdb/sim.db
type = postgres
host = localhost
port = 5432
user = simdb
password = {{ db_password }}

[validation]
path = {{ install_home }}/current/validation/validation-schema.yaml
auto_validate = True
error_on_fail = True

[validation "schema="]
# Validation to use when no schema is specified
path = {{ install_home }}/current/validation/validation-schema-plasma.yaml
error_on_fail = True

[validation "schema=plasma"]
path = {{ install_home }}/current/validation/validation-schema-plasma.yaml
error_on_fail = True

[validation "schema=step"]
path = {{ install_home }}/current/validation/validation-schema-step.yaml
error_on_fail = True

[role "admin"]
users = admin

[cache]
type = FileSystemCache
dir = {{ install_home }}/current/cache
default_timeout = 6000
threshold = 100

[authentication]
type = Okta
okta_url = https://integrator-8447942.okta.com/oauth2/default
okta_audience = api://default
okta_cli_client_id = 0oa1618fq81UI7cQx698
okta_ui_client_id = 0oa15ztipydyXI4ZB698

[development]
disable_checksum = True
