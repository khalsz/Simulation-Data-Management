#!/bin/bash

# requires password set in .pgpass
cd /tmp
name="$(hostname -s)-$(date '+%Y-%m-%d-%H%M%S').sql.gz"
pg_dump -U simdb -h localhost -d simdb --compress=gzip -f "/tmp/${name}"
mv /tmp/${name} "{{ db_backup_dir }}/."

# only keep the last 11 days of backups
ls -tp "{{ db_backup_dir }}/*.sql.gz" | grep -v '/$' | tail -n +11 | xargs -I {} rm -- "{{ db_backup_dir }}/{}"
